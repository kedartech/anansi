# The Discord gateway bot (build plan Layer 9a). Long-running, unlike the
# scheduler. User unit: /advance runs live ticks, and the Claude CLI login
# lives in this user's home. Install and enable: docs/deploy.md §9.
[Unit]
Description=Revisionist: Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/revisionist/revisionist.env
# `claude` must be on this PATH for /order, /briefing and /advance
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/.local/share/revisionist
ExecStart=%h/.local/bin/revisionist discord run
Restart=on-failure
RestartSec=30s
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# Not MemoryDenyWriteExecute: the Claude CLI runs on Node, whose JIT needs it.
# Not ProtectHome: the Claude CLI reads its login from the home directory.

[Install]
WantedBy=default.target
