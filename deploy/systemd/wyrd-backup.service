# Nightly pg_dump, kept locally with retention, then copied off the box.
[Unit]
Description=Wyrd Protocol: back up the database
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/wyrd/wyrd-admin.env
ExecStart=%h/.local/bin/wyrd-backup
TimeoutStartSec=30min
Nice=10
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
