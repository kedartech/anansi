    "item": {"id": "d-whip-1017", "kind": "whip_count", "title": "House count on the Neutrality Act revision", "author": "Sam Rayburn", "issued": "1941-10-17", "arrives": "1941-10-19", "channel": "letter", "classification": "confidential", "unread": true},
