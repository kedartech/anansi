  "page": {
    "item": {"id": "d-whip-1017", "kind": "whip_count", "title": "House count on the Neutrality Act revision", "author": "Sam Rayburn", "issued": "1941-10-17", "arrives": "1941-10-19", "channel": "letter", "classification": "confidential", "unread": true, "flagged": false},
    "body": [
      {"label": "Members counted", "value": 391, "unit": "members"},
      {"label": "Committed in favour", "value": 190, "unit": "members"},
      {"label": "Committed against", "value": 170, "unit": "members"},
      {"label": "Unsure", "value": 31, "unit": "members"},
      {"label": "Absentee estimate", "value": null, "unit": "members"}
    ],
    "prose": "Mr. President,\n\nThe count is not yet where either of us would like it. I believe the doubtful members will follow the Speaker once the Senate has acted, but I would not stake the session on it.\n\nI shall report again when the last of the committee chairmen has been seen."
  },
  "reply": {
    "item": {"id": "d-reply-1012", "kind": "letter", "title": "On your order: Send a bill to Congress", "author": "Sam Rayburn", "issued": "1941-10-12", "arrives": "1941-10-12", "channel": "letter", "classification": "confidential", "unread": false, "flagged": false},
    "body": [
      {"label": "What was done", "value": "passed it on", "unit": ""},
      {"label": "Order", "value": "Send a bill to Congress", "unit": ""}
    ],
    "prose": "Mr. President,\n\nI have taken the bill and passed it on to committee, as you asked."
  },
